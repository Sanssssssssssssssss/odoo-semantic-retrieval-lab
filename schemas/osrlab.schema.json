{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/osrlab/schema/v1",
  "$defs": {
    "SpanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "start_line", "start_column", "end_line", "end_column", "anchor", "origin_kind", "quote_sha256"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 1},
        "anchor": {"type": ["string", "null"]},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin_kind": {"enum": ["direct", "include", "substitution", "generated"]}
      }
    },
    "SourceSnapshot": {
      "type": "object",
      "required": ["schema_version", "repository_url", "commit", "manifest_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "repository_url": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "SourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_snapshot_id", "source_path", "source_sha256", "public_uri"],
      "properties": {
        "id": {"type": "string"}, "source_snapshot_id": {"type": "string"},
        "source_path": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_uri": {"type": "string"}, "scope": {"type": "string"}
      }
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_document_id", "span_refs"],
      "properties": {
        "id": {"type": "string"}, "source_document_id": {"type": "string"},
        "span_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SpanRef"}}
      }
    },
    "EvidenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_document_id", "source_span_ids", "node_type", "ordinal", "heading_path", "section_id", "parent_section_id", "anchor", "anchors", "source_uri", "structure_context", "rendered_text", "lexical_text", "cross_references", "content_sha256"],
      "properties": {
        "id": {"type": "string"}, "source_document_id": {"type": "string"},
        "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "node_type": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 0},
        "heading_path": {"type": "array", "items": {"type": "string"}},
        "section_id": {"type": "string"}, "parent_section_id": {"type": ["string", "null"]},
        "anchor": {"type": ["string", "null"]}, "anchors": {"type": "array", "items": {"type": "string"}},
        "source_uri": {"type": "string"},
        "structure_context": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "label"], "properties": {"kind": {"enum": ["tab"]}, "label": {"type": "string"}}}},
        "rendered_text": {"type": "string"}, "lexical_text": {"type": "string"},
        "cross_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "target"], "properties": {"text": {"type": "string"}, "target": {"type": "string"}}}},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ChunkConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "tokenizer_id", "tokenizer_revision", "parameters", "config_sha256"],
      "properties": {
        "id": {"enum": ["C0-fixed", "C1-section-native", "C2-structure-bounded", "C3-structure-merged"]},
        "schema_version": {"const": 1},
        "tokenizer_id": {"const": "BAAI/bge-small-en-v1.5"},
        "tokenizer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parameters": {"type": "object"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "SpanFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_unit_id", "source_span_ids", "source_uri", "anchor", "unit_token_start", "unit_token_end", "chunk_token_start", "chunk_token_end", "unit_char_start", "unit_char_end"],
      "properties": {
        "evidence_unit_id": {"type": "string"},
        "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_uri": {"type": "string"},
        "anchor": {"type": ["string", "null"]},
        "unit_token_start": {"type": "integer", "minimum": 0},
        "unit_token_end": {"type": "integer", "minimum": 1},
        "chunk_token_start": {"type": "integer", "minimum": 0},
        "chunk_token_end": {"type": "integer", "minimum": 1},
        "unit_char_start": {"type": "integer", "minimum": 0},
        "unit_char_end": {"type": "integer", "minimum": 1}
      }
    },
    "TokenWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_start", "token_end"],
      "properties": {
        "token_start": {"type": "integer", "minimum": 0},
        "token_end": {"type": "integer", "minimum": 1}
      }
    },
    "Chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "source_snapshot_id", "chunk_config_id", "chunk_config_hash", "source_document_id", "source_uri", "section_ids", "parent_section_ids", "heading_path", "title", "text", "text_sha256", "token_count", "span_fragments", "scoring_windows", "component_chunk_ids"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1},
        "source_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "chunk_config_id": {"type": "string"},
        "chunk_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_document_id": {"type": "string"}, "source_uri": {"type": "string"},
        "section_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "parent_section_ids": {"type": "array", "items": {"type": "string"}},
        "heading_path": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string"}, "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "token_count": {"type": "integer", "minimum": 1},
        "span_fragments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SpanFragment"}},
        "scoring_windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TokenWindow"}},
        "component_chunk_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Query": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "text", "intent", "answerability", "no_answer_reason", "evidence_topology", "source_fact_group", "smoke", "smoke_slice", "annotation_version", "status"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1}, "text": {"type": "string", "minLength": 1},
        "intent": {"enum": ["exact_identifier", "prerequisite", "ordered_procedure", "action_semantics", "diagnosis", "cross_module", "comparison", "version_applicability"]},
        "answerability": {"enum": ["answerable", "no_answer"]},
        "no_answer_reason": {"enum": [null, "absent_from_corpus", "requires_live_instance", "wrong_version", "enterprise_or_excluded", "ambiguous_requires_clarification", "out_of_scope"]},
        "evidence_topology": {"enum": [null, "single_span", "same_page_multi_span", "cross_page"]},
        "source_fact_group": {"type": "string", "minLength": 1},
        "smoke": {"type": "boolean"}, "smoke_slice": {"enum": [null, "lexical", "semantic", "multi_evidence", "no_answer"]},
        "annotation_version": {"type": "integer", "minimum": 1}, "status": {"enum": ["provisional", "frozen"]}
      }
    },
    "Nugget": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "query_id", "text", "required", "source_span_ids", "status"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1}, "query_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1}, "required": {"type": "boolean"},
        "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["provisional", "frozen"]}
      }
    },
    "Judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "query_id", "source_span_id", "nugget_ids", "grade", "rationale", "status"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1}, "query_id": {"type": "string"},
        "source_span_id": {"type": "string"}, "nugget_ids": {"type": "array", "items": {"type": "string"}},
        "grade": {"type": "integer", "minimum": 0, "maximum": 3}, "rationale": {"type": "string"},
        "status": {"enum": ["provisional", "frozen"]}
      }
    },
    "AnnotationNugget": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "text", "required", "source_span_ids"],
      "properties": {
        "local_id": {"type": "string"}, "text": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}, "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "AnnotationJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["source_span_id", "grade", "local_nugget_ids", "rationale"],
      "properties": {
        "source_span_id": {"type": "string"}, "grade": {"type": "integer", "minimum": 0, "maximum": 3},
        "local_nugget_ids": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"}
      }
    },
    "AnnotationSubmission": {
      "type": "object", "additionalProperties": false,
      "required": ["brief_id", "annotator_id", "query_text", "intent", "answerability", "no_answer_reason", "evidence_topology", "source_fact_group", "nuggets", "judgments", "notes"],
      "properties": {
        "brief_id": {"type": "string"}, "annotator_id": {"type": "string"}, "query_text": {"type": "string", "minLength": 1},
        "intent": {"$ref": "#/$defs/Query/properties/intent"}, "answerability": {"$ref": "#/$defs/Query/properties/answerability"},
        "no_answer_reason": {"$ref": "#/$defs/Query/properties/no_answer_reason"}, "evidence_topology": {"$ref": "#/$defs/Query/properties/evidence_topology"},
        "source_fact_group": {"type": "string", "minLength": 1},
        "nuggets": {"type": "array", "items": {"$ref": "#/$defs/AnnotationNugget"}},
        "judgments": {"type": "array", "items": {"$ref": "#/$defs/AnnotationJudgment"}}, "notes": {"type": "string"}
      }
    },
    "TopicBrief": {
      "type": "object", "additionalProperties": false,
      "required": ["brief_id", "query_text", "intent", "answerability", "no_answer_reason", "evidence_topology", "source_hint_paths", "rationale", "smoke", "smoke_slice"],
      "properties": {
        "brief_id": {"type": "string", "pattern": "^S[0-9]{3}$"}, "query_text": {"type": "string", "minLength": 1},
        "intent": {"$ref": "#/$defs/Query/properties/intent"}, "answerability": {"$ref": "#/$defs/Query/properties/answerability"},
        "no_answer_reason": {"$ref": "#/$defs/Query/properties/no_answer_reason"}, "evidence_topology": {"$ref": "#/$defs/Query/properties/evidence_topology"},
        "source_hint_paths": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string", "minLength": 1},
        "smoke": {"type": "boolean"}, "smoke_slice": {"$ref": "#/$defs/Query/properties/smoke_slice"}
      }
    },
    "HardNegative": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "query_id", "source_span_id", "grade", "provenance", "status"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1}, "query_id": {"type": "string"},
        "source_span_id": {"type": "string"}, "grade": {"type": "integer", "minimum": 0, "maximum": 1},
        "provenance": {"enum": ["seeded_agent_candidate", "sibling_section", "lexical_collision", "semantic_nearest", "wrong_module", "wrong_version", "procedure_step_confusion", "baseline_false_positive"]},
        "status": {"enum": ["provisional", "frozen"]}
      }
    },
    "EvidenceCard": {"type": "object", "required": ["query_id", "rank", "chunk_id", "source_uri", "excerpt", "token_count"]},
    "RunManifest": {"type": "object", "required": ["id", "system", "corpus_hash", "benchmark_hash", "config_hash"]},
    "StageTiming": {"type": "object", "required": ["run_id", "query_id", "stage", "duration_ns"]},
    "ResourceSample": {"type": "object", "required": ["run_id", "monotonic_ns", "rss_bytes"]}
  }
}
