{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/osrlab/schema/v1",
  "$defs": {
    "SpanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "start_line", "start_column", "end_line", "end_column", "anchor", "origin_kind", "quote_sha256"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 1},
        "anchor": {"type": ["string", "null"]},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "origin_kind": {"enum": ["direct", "include", "substitution", "generated"]}
      }
    },
    "SourceSnapshot": {
      "type": "object",
      "required": ["schema_version", "repository_url", "commit", "manifest_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "repository_url": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "SourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_snapshot_id", "source_path", "source_sha256", "public_uri"],
      "properties": {
        "id": {"type": "string"}, "source_snapshot_id": {"type": "string"},
        "source_path": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "public_uri": {"type": "string"}, "scope": {"type": "string"}
      }
    },
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_document_id", "span_refs"],
      "properties": {
        "id": {"type": "string"}, "source_document_id": {"type": "string"},
        "span_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SpanRef"}}
      }
    },
    "EvidenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_document_id", "source_span_ids", "node_type", "ordinal", "heading_path", "section_id", "parent_section_id", "anchor", "anchors", "source_uri", "structure_context", "rendered_text", "lexical_text", "cross_references", "content_sha256"],
      "properties": {
        "id": {"type": "string"}, "source_document_id": {"type": "string"},
        "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "node_type": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 0},
        "heading_path": {"type": "array", "items": {"type": "string"}},
        "section_id": {"type": "string"}, "parent_section_id": {"type": ["string", "null"]},
        "anchor": {"type": ["string", "null"]}, "anchors": {"type": "array", "items": {"type": "string"}},
        "source_uri": {"type": "string"},
        "structure_context": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "label"], "properties": {"kind": {"enum": ["tab"]}, "label": {"type": "string"}}}},
        "rendered_text": {"type": "string"}, "lexical_text": {"type": "string"},
        "cross_references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["text", "target"], "properties": {"text": {"type": "string"}, "target": {"type": "string"}}}},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ChunkConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "tokenizer_id", "tokenizer_revision", "parameters", "config_sha256"],
      "properties": {
        "id": {"enum": ["C0-fixed", "C1-section-native", "C2-structure-bounded", "C3-structure-merged"]},
        "schema_version": {"const": 1},
        "tokenizer_id": {"const": "BAAI/bge-small-en-v1.5"},
        "tokenizer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parameters": {"type": "object"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "SpanFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_unit_id", "source_span_ids", "source_uri", "anchor", "unit_token_start", "unit_token_end", "chunk_token_start", "chunk_token_end", "unit_char_start", "unit_char_end"],
      "properties": {
        "evidence_unit_id": {"type": "string"},
        "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_uri": {"type": "string"},
        "anchor": {"type": ["string", "null"]},
        "unit_token_start": {"type": "integer", "minimum": 0},
        "unit_token_end": {"type": "integer", "minimum": 1},
        "chunk_token_start": {"type": "integer", "minimum": 0},
        "chunk_token_end": {"type": "integer", "minimum": 1},
        "unit_char_start": {"type": "integer", "minimum": 0},
        "unit_char_end": {"type": "integer", "minimum": 1}
      }
    },
    "TokenWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_start", "token_end"],
      "properties": {
        "token_start": {"type": "integer", "minimum": 0},
        "token_end": {"type": "integer", "minimum": 1}
      }
    },
    "Chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "source_snapshot_id", "chunk_config_id", "chunk_config_hash", "source_document_id", "source_uri", "section_ids", "parent_section_ids", "heading_path", "title", "text", "text_sha256", "token_count", "span_fragments", "scoring_windows", "component_chunk_ids"],
      "properties": {
        "id": {"type": "string"}, "schema_version": {"const": 1},
        "source_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "chunk_config_id": {"type": "string"},
        "chunk_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_document_id": {"type": "string"}, "source_uri": {"type": "string"},
        "section_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "parent_section_ids": {"type": "array", "items": {"type": "string"}},
        "heading_path": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string"}, "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "token_count": {"type": "integer", "minimum": 1},
        "span_fragments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SpanFragment"}},
        "scoring_windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/TokenWindow"}},
        "component_chunk_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Query": {"type": "object", "required": ["id", "text", "intent", "answerability", "status"]},
    "Nugget": {"type": "object", "required": ["id", "query_id", "text", "required", "source_span_ids"]},
    "Judgment": {"type": "object", "required": ["query_id", "source_span_id", "grade", "status"]},
    "HardNegative": {"type": "object", "required": ["query_id", "source_span_id", "grade", "provenance"]},
    "EvidenceCard": {"type": "object", "required": ["query_id", "rank", "chunk_id", "source_uri", "excerpt", "token_count"]},
    "RunManifest": {"type": "object", "required": ["id", "system", "corpus_hash", "benchmark_hash", "config_hash"]},
    "StageTiming": {"type": "object", "required": ["run_id", "query_id", "stage", "duration_ns"]},
    "ResourceSample": {"type": "object", "required": ["run_id", "monotonic_ns", "rss_bytes"]}
  }
}
